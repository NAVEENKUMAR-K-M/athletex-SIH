# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets / local config — never commit
*.env
.env
.env.*
!.env.example
secrets.dart
key.properties
*.keystore
*.jks
*.p12
*.pem
